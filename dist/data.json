  "sql": {
    "order_economics": "{{ config(materialized='incremental',unique_key='order_id',incremental_strategy='delete+insert') }}\n-- Aggregate each child independently; joining line items to payments directly multiplies money.\nwith lines as (select order_id,sum(gross)::bigint as gross,sum(discount)::bigint as discount,\n sum(cogs)::bigint as cogs,sum(refunded)::bigint as refunded,sum(net_revenue)::bigint as net_revenue\n from {{ ref('line_economics') }} group by order_id),\n fees as (select order_id,sum(fee)::bigint as fees from {{ source('raw','payments') }} where status='succeeded' group by order_id)\nselect o.order_id,o.customer_id,o.ordered_at,o.channel,l.gross,l.discount,l.cogs,o.shipping,\n coalesce(f.fees,0)::bigint as fees,l.refunded,l.net_revenue,\n (l.net_revenue-l.cogs-o.shipping-coalesce(f.fees,0))::bigint as contribution_before_ads\nfrom {{ source('raw','orders') }} o join lines l using(order_id) left join fees f using(order_id)\n{% if is_incremental() %}where o.order_id in ({{ changed_orders() }}){% endif %}\n",
    "channel_acquisition": "-- First observed order; deterministic same-day tie break by order_id.\nwith ranked as (\n select *,row_number() over(partition by customer_id order by ordered_at,order_id) as rn from {{ source('raw','orders') }}\n), acquired as (\n select channel,count(*) as first_customers from ranked where rn=1 group by channel\n), economics as (\n select channel,sum(ad_spend)::bigint as ad_spend,sum(net_revenue)::bigint as net_revenue\n from {{ ref('monthly') }} group by channel\n)\nselect e.*,coalesce(a.first_customers,0)::bigint as first_customers,\n e.ad_spend*1.0/nullif(a.first_customers,0) as first_order_cac_paise,\n e.net_revenue*1.0/nullif(e.ad_spend,0) as blended_revenue_to_spend\nfrom economics e left join acquired a using(channel)\n",
    "line_economics": "{{ config(materialized='incremental',unique_key='line_id',incremental_strategy='delete+insert') }}\nwith refunds as (select line_id,sum(amount)::bigint as refunded from {{ source('raw','refunds') }} group by line_id)\nselect l.line_id,l.order_id,o.customer_id,o.ordered_at,o.channel,l.product,l.quantity,\n (l.quantity*l.unit_price)::bigint as gross,l.discount,(l.quantity*l.unit_cost)::bigint as cogs,\n coalesce(r.refunded,0)::bigint as refunded,\n (l.quantity*l.unit_price-l.discount-coalesce(r.refunded,0))::bigint as net_revenue,\n (l.quantity*(l.unit_price-l.unit_cost)-l.discount-coalesce(r.refunded,0))::bigint as merchandise_contribution\nfrom {{ source('raw','line_items') }} l join {{ source('raw','orders') }} o using(order_id)\nleft join refunds r using(line_id)\n{% if is_incremental() %}where l.order_id in ({{ changed_orders() }}){% endif %}\n",
    "payment_reconciliation": "{{ config(materialized='incremental',unique_key='order_id',incremental_strategy='delete+insert') }}\nwith cash as (select order_id,\n sum(case when kind='capture' and status='succeeded' then amount else 0 end)::bigint as captured,\n sum(case when kind='refund' and status='succeeded' then amount else 0 end)::bigint as returned,\n count(*) filter(where status='failed')::bigint as failed_attempts\n from {{ source('raw','payments') }} group by order_id)\nselect o.order_id,o.channel,(o.gross-o.discount)::bigint as charged,o.refunded as refund_granted,\n coalesce(captured,0)::bigint as captured,coalesce(returned,0)::bigint as returned,\n (o.gross-o.discount-coalesce(captured,0))::bigint as collection_gap,\n (o.refunded-coalesce(returned,0))::bigint as refund_payable,\n (coalesce(captured,0)-coalesce(returned,0))::bigint as cash_net,\n coalesce(failed_attempts,0)::bigint as failed_attempts\nfrom {{ ref('order_economics') }} o left join cash using(order_id)\n{% if is_incremental() %}where o.order_id in ({{ changed_orders() }}){% endif %}\n",
    "monthly": "{{ config(materialized='incremental',unique_key=['month','channel'],incremental_strategy='delete+insert') }}\n-- Revenue follows order date; refund grants and actual payment fees follow their event dates.\nwith ledger as (\n select date_trunc('month',ordered_at)::date as month,channel,gross,discount,0::bigint as refunds,cogs,shipping,0::bigint as fees,0::bigint as ad_spend,1 as orders from {{ ref('order_economics') }}\n union all select date_trunc('month',r.refunded_at)::date,o.channel,0,0,r.amount,0,0,0,0,0\n from {{ source('raw','refunds') }} r join {{ source('raw','line_items') }} l using(line_id) join {{ source('raw','orders') }} o using(order_id)\n union all select date_trunc('month',p.occurred_at)::date,o.channel,0,0,0,0,0,p.fee,0,0 from {{ source('raw','payments') }} p join {{ source('raw','orders') }} o using(order_id) where p.status='succeeded'\n union all select date_trunc('month',spent_at)::date,channel,0,0,0,0,0,0,amount,0 from {{ source('raw','spend') }}\n), affected as (\n select date_trunc('month',ordered_at)::date as month,channel from {{ source('raw','orders') }} where order_id in ({{ changed_orders() }})\n union select date_trunc('month',r.refunded_at)::date,o.channel from {{ source('raw','refunds') }} r join {{ source('raw','line_items') }} l using(line_id) join {{ source('raw','orders') }} o using(order_id) where r._batch_id>{{ var('lower_batch',0) }}\n union select date_trunc('month',p.occurred_at)::date,o.channel from {{ source('raw','payments') }} p join {{ source('raw','orders') }} o using(order_id) where p._batch_id>{{ var('lower_batch',0) }}\n union select date_trunc('month',spent_at)::date,channel from {{ source('raw','spend') }} where _batch_id>{{ var('lower_batch',0) }}\n)\nselect month,channel,sum(orders)::bigint as orders,sum(gross)::bigint as gross,sum(discount)::bigint as discount,\n sum(refunds)::bigint as refunds,sum(cogs)::bigint as cogs,sum(shipping)::bigint as shipping,sum(fees)::bigint as fees,\n sum(ad_spend)::bigint as ad_spend,sum(gross-discount-refunds)::bigint as net_revenue,\n sum(gross-discount-refunds-cogs-shipping-fees-ad_spend)::bigint as contribution\nfrom ledger\n{% if is_incremental() %}where (month,channel) in (select month,channel from affected){% endif %}\ngroup by all\n",
    "sku_returns": "{{ config(materialized='incremental',unique_key=['channel','product'],incremental_strategy='delete+insert') }}\nselect channel,product,count(distinct order_id)::bigint as orders,sum(quantity)::bigint as units,\n count(distinct order_id) filter(where refunded>0)::bigint as refunded_orders,\n sum(refunded)::bigint as refund_amount,sum(gross-discount)::bigint as charged_revenue,\n sum(net_revenue)::bigint as net_revenue,sum(merchandise_contribution)::bigint as merchandise_contribution,\n count(distinct order_id) filter(where refunded>0)*1.0/count(distinct order_id) as refunded_order_rate,\n sum(refunded)*1.0/nullif(sum(gross-discount),0) as refund_value_rate\nfrom {{ ref('line_economics') }}\n{% if is_incremental() %}where (channel,product) in (select channel,product from {{ ref('line_economics') }} where order_id in ({{ changed_orders() }})){% endif %}\ngroup by all\n",
    "retention": "-- 30-day repurchase, exclusive first date and inclusive day 30; immature users excluded.\nwith first_order as (\n select customer_id,min(ordered_at) as acquired from {{ source('raw','orders') }} group by customer_id\n), customers as (\n select f.customer_id,f.acquired,\n max(case when o.ordered_at>acquired and o.ordered_at<=acquired+30 then 1 else 0 end) as repeated\n from first_order f join {{ source('raw','orders') }} o using(customer_id)\n where acquired<=date '{{ var(\"as_of\", \"2026-06-30\") }}'-30\n and o.ordered_at<=date '{{ var(\"as_of\", \"2026-06-30\") }}'\n group by all\n)\nselect date_trunc('month',acquired)::date as cohort,count(*) as eligible_customers,\n sum(repeated)::bigint as repeat_customers, sum(repeated)*1.0/count(*) as retention_30d\nfrom customers group by all\n"
  },
